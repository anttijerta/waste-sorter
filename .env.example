# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Models (mock ids until real model calls are added)
MODEL_A=mock-a
MODEL_B=mock-b

# Database (the container default is /app/data/db.sqlite3)
DB_PATH=./data/db.sqlite3
