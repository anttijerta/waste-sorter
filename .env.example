# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Models (OpenAI). Without MODEL_API_KEY the app runs in demo mode with
# simulated models. Never commit a real key.
MODEL_A=gpt-6-luna
MODEL_B=gpt-6.1-sol
MODEL_API_KEY=
# Production (NODE_ENV=production) refuses to start without a key unless this is true.
ALLOW_MOCK_MODELS=false
# Same effort for both models; empty means "low". Must be supported by both.
MODEL_REASONING_EFFORT=
MODEL_TIMEOUT_MS=20000

# Database (the container default is /app/data/db.sqlite3)
DB_PATH=./data/db.sqlite3

# Usage caps
RATE_LIMIT_PER_IP_PER_MINUTE=5
RATE_LIMIT_PER_IP_DAILY=20
GLOBAL_MONTHLY_CAP_EUR=5
# Reverse proxy IPs/CIDRs allowed to set X-Forwarded-For. Empty trusts none.
TRUSTED_PROXIES=

# Eval: folder with labels.csv, images-jpg/ and results/, outside this repo
EVAL_DATA_DIR=
